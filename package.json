{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:new": "eslint src/lib src/ui src/theme src/features src/test src/routes/newUiRoutes.tsx src/routes/legacyPages.tsx src/routes/pageRegistry.ts src/routes/pageRegistry.test.ts src/routes/moduleSlots.ts src/routes/ModuleSlot.tsx src/routes/devRoutes.tsx src/main.tsx e2e playwright.config.ts playwright.ui.config.ts playwright.ds-real.config.ts vitest.config.ts --ext ts,tsx --max-warnings 0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ds-real": "playwright test --config playwright.ds-real.config.ts",
    "test:ui-snapshots": "playwright test -c playwright.ui.config.ts",
    "preview": "vite preview",
    "check:studio-contracts": "node scripts/check-studio-contracts.mjs",
    "sync:studio-render": "node scripts/sync-studio-render.mjs",
    "check:studio-render": "node scripts/sync-studio-render.mjs check",
    "sync:studio-resize": "node scripts/sync-studio-resize.mjs"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.20.8",
    "@react-pdf/renderer": "^4.3.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-highlight": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "axios": "1.13.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "tailwindcss": "^4.1.18",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "jsdom": "^25.0.1",
    "msw": "2.4.9",
    "typescript": "^5.0.2",
    "vite": "^4.4.5",
    "vitest": "^0.34.6"
  }
}
